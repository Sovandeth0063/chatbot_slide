# Set default behavior to automatically normalize line endings
* text=auto

# Force LF for text-based source files
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.py text eol=lf
*.md text eol=lf

# Keep binary files as binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
